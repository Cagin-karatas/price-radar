# Veritabani. Docker Compose disinda calisiyorsan SQLite yeter.
PRICERADAR_DATABASE_URL=sqlite+aiosqlite:///priceradar.db
# PRICERADAR_DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/priceradar

# Scraping davranisi
PRICERADAR_MIN_INTERVAL=1.0
PRICERADAR_MAX_CONCURRENCY=5
PRICERADAR_MAX_RETRIES=3
PRICERADAR_RESPECT_ROBOTS=true

# Proxy havuzu (JSON dizisi). Bos birakilirsa dogrudan baglanilir.
# PRICERADAR_PROXIES=["http://user:pass@proxy1:8080","http://proxy2:8080"]

# Urun eslestirme esigi (0-1). Yukseltirsen daha az birlestirme yapar.
PRICERADAR_MATCH_THRESHOLD=0.82

# Bildirim (Faz 3)
PRICERADAR_SMTP_HOST=smtp.gmail.com
PRICERADAR_SMTP_PORT=587
PRICERADAR_SMTP_USER=
PRICERADAR_SMTP_PASSWORD=
